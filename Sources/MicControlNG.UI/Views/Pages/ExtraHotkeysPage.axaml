<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MicControlNG.Controls"
             xmlns:vm="using:MicControlNG.ViewModels"
             xmlns:s="using:MicControlNG.Settings"
             xmlns:p="using:MicControlNG.Platform"
             x:Class="MicControlNG.Views.Pages.ExtraHotkeysPage"
             x:DataType="vm:MainViewModel">
    <StackPanel Classes="page">
        <TextBlock Classes="pageTitle" Text="Extra hotkeys" />
        <TextBlock Classes="pageSubtitle" Text="Add keys for specific actions: mute, unmute, speaker volume and more. Your main key is set on Home." />

        <TextBlock Classes="secondary" Margin="4,8,0,12" FontSize="14" Text="No extra hotkeys yet." IsVisible="{Binding !HasExtraHotkeys}" />
        <ItemsControl ItemsSource="{Binding ExtraHotkeys}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExtraHotkeyViewModel">
                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <ToggleSwitch IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"
                                          ToolTip.Tip="Turn this hotkey on or off" AutomationProperties.Name="Enabled" />
                            <ComboBox Grid.Column="1" MinWidth="240" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding Actions}" SelectedValue="{Binding Action}"
                                      DisplayMemberBinding="{Binding Name, x:DataType=vm:Choice}" SelectedValueBinding="{Binding Value, x:DataType=vm:Choice}"
                                      AutomationProperties.Name="Action" />
                            <Button Grid.Column="2" Padding="8" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Content="&#xE74D;"
                                    Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this hotkey" AutomationProperties.Name="Remove" />
                            <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Content="{Binding Editor}" ContentTemplate="{StaticResource HotkeyEditorTemplate}" IsEnabled="{Binding IsEnabled}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="accent" Margin="0,8,0,0" Padding="14,8" Command="{Binding AddExtraHotkeyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="glyph" FontSize="14" Text="&#xE710;" />
                <TextBlock Text="Add hotkey" />
            </StackPanel>
        </Button>

        <StackPanel IsVisible="{Binding HasSpeakerActions}">
            <TextBlock Classes="section" Text="Speakers" />
            <c:SettingRow Glyph="&#xE7F5;" Header="Speaker device" Description="Which output the speaker actions control">
                <ComboBox MinWidth="280" ItemsSource="{Binding Speakers}" SelectedValue="{Binding SelectedSpeakerId}"
                          DisplayMemberBinding="{Binding Name, x:DataType=p:AudioDeviceInfo}" SelectedValueBinding="{Binding Id, x:DataType=p:AudioDeviceInfo}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE767;" Header="Speaker volume">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding SpeakerVolume}" VerticalAlignment="Center" AutomationProperties.Name="Speaker volume" />
                    <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SpeakerVolume, StringFormat={}{0:0}%}" />
                </StackPanel>
            </c:SettingRow>
        </StackPanel>
    </StackPanel>
</UserControl>
