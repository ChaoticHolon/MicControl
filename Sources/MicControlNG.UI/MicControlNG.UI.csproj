<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform Avalonia UI: views, view models and app composition. Platform code lives in MicControlNG.<OS>. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: windows take their services through the constructor, so the runtime XAML loader can't create them. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicControlNG.Core\MicControlNG.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\*.png" />
    <Content Include="Assets\Notifications\*.wav" CopyToOutputDirectory="PreserveNewest" Link="Resources\Notifications\%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="MicControlNG.Tests" />
  </ItemGroup>
</Project>
