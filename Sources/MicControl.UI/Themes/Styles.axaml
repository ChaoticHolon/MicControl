<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.caution">
        <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,24,0,8" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Background" Value="{StaticResource DisconnectedBrush}" />
    </Style>
    <Style Selector="Border.badge.muted">
        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Border.badge.live">
        <Setter Property="Background" Value="{StaticResource LiveBrush}" />
    </Style>
    <!-- Page layout -->
    <Style Selector="StackPanel.page">
        <Setter Property="Margin" Value="32,8,32,32" />
        <Setter Property="MaxWidth" Value="1000" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,24,0,4" />
    </Style>
    <!-- The card at the top of Home and About: the same padding, 56 px icon, title, detail line and button -->
    <Style Selector="Border.hero">
        <Setter Property="Padding" Value="24,20" />
    </Style>
    <Style Selector="TextBlock.heroTitle">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heroDetail">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.heroAction">
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Segmented control (Theme): a pill of options, the chosen one filled with the accent colour -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="RadioButton.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Segment" Background="{TemplateBinding Background}" CornerRadius="14" Padding="14,5">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}" FontSize="13" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="TextBlock.pageSubtitle">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,0,0,12" />
    </Style>

    <!-- Page tabs in the header: an accent underline marks the open page -->
    <Style Selector="ListBox.tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
        <Setter Property="Padding" Value="12,6,12,0" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    </Style>
    <Style Selector="ListBox.tabs TextBlock.brand">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.tabLine">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected Border.tabLine">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>

    <!-- Header status chip: a quiet pill (state + action), so it doesn't repeat Home's big accent button -->
    <Style Selector="Button.statusChip">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="6,0,14,0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chipSizer">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.statusChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <!-- Level meter -->
    <Style Selector="ProgressBar.meter">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LiveBrush}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
    </Style>

    <!-- Overlay badge -->
    <Style Selector="Border.micDot">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource LiveBrush}" />
    </Style>
    <Style Selector="Border.micDot.muted">
        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Border.overlayPill">
        <Setter Property="Background" Value="{StaticResource OverlayBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="6,6,14,6" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.overlayPill.compact">
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.overlayPill.speaking">
        <Setter Property="BorderBrush" Value="{StaticResource SpeakingBrush}" />
    </Style>
    <Style Selector="Border.overlayPill.editing">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
</Styles>
