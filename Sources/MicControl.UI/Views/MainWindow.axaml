<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicControl.ViewModels"
        xmlns:pages="using:MicControl.Views.Pages"
        x:Class="MicControl.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1000" Height="720" MinWidth="780" MinHeight="520"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Panel>
        <DockPanel>
            <!-- Header: the app name, page tabs and (away from Home, which shows it already) the microphone state -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,8,24,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,28,6" Text="{Binding Title}" />
                    <ListBox Grid.Column="1" Classes="tabs" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                        <TextBlock Classes="glyph" FontSize="17" VerticalAlignment="Center" Text="{Binding Glyph}" />
                                        <TextBlock FontSize="15" VerticalAlignment="Center" Text="{Binding Title}" />
                                    </StackPanel>
                                    <Border Classes="tabLine" Margin="0,10,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0,0,6"
                                IsVisible="{Binding !IsHomePage}" ToolTip.Tip="{Binding MainHotkeySummary}">
                        <Border Classes="micDot" Classes.muted="{Binding IsMutedState}" Width="26" Height="26" CornerRadius="13">
                            <TextBlock Classes="glyph" FontSize="13" Foreground="White" HorizontalAlignment="Center" Text="{Binding StatusGlyph}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding StateLabel}" />
                        <Button Classes="accent" MinWidth="96" HorizontalContentAlignment="Center" Padding="14,6"
                                Content="{Binding ToggleMuteText}" Command="{Binding ToggleMuteCommand}" IsEnabled="{Binding IsMicrophoneConnected}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="32,12,32,0" MaxWidth="1000">
                    <Border Classes="card caution" IsVisible="{Binding Capabilities.LimitationNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <DockPanel>
                            <TextBlock Classes="glyph" Text="&#xE7BA;" Margin="0,0,12,0" Foreground="{DynamicResource CautionForegroundBrush}" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Capabilities.LimitationNotice}" />
                        </DockPanel>
                    </Border>
                    <Border Classes="card" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" Padding="8"
                                    Command="{Binding DismissStatusCommand}" AutomationProperties.Name="Dismiss" />
                            <TextBlock Classes="glyph" Text="&#xE946;" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Panel>
                        <pages:HomePage IsVisible="{Binding IsHomePage}" />
                        <pages:SoundsPage IsVisible="{Binding IsSoundsPage}" />
                        <pages:OverlayPage IsVisible="{Binding IsOverlayPage}" />
                        <pages:CustomHotkeysPage IsVisible="{Binding IsCustomHotkeysPage}" />
                        <pages:AboutPage IsVisible="{Binding IsAboutPage}" />
                    </Panel>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>

        <pages:SetupView IsVisible="{Binding IsSetupVisible}" />
    </Panel>
</Window>
