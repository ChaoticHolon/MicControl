<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicControl.ViewModels"
        xmlns:pages="using:MicControl.Views.Pages"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MicControl.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1000" Height="720" MinWidth="780" MinHeight="520"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="52">
    <Panel>
        <DockPanel>
            <!-- Header, drawn in the title bar like a browser: icon and name, page tabs, (away from Home, which shows it
                 already) the microphone state, then room for the system's minimize, maximize and close buttons.
                 Empty space drags the window; the tabs and buttons are marked User so they get clicks. -->
            <Border DockPanel.Dock="Top" Height="52" Padding="16,0,0,0" Background="Transparent"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <Image Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Source="{Binding CurrentIcon}"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" Text="{Binding Title}" />
                    <ListBox Grid.Column="2" Classes="tabs" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             chrome:WindowDecorationProperties.ElementRole="User">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                        <TextBlock Classes="glyph" FontSize="17" VerticalAlignment="Center" Text="{Binding Glyph}" />
                                        <TextBlock FontSize="15" VerticalAlignment="Center" Text="{Binding Title}" />
                                    </StackPanel>
                                    <Border Classes="tabLine" Margin="0,10,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0,12,0"
                                IsVisible="{Binding !IsHomePage}" ToolTip.Tip="{Binding MainHotkeySummary}"
                                chrome:WindowDecorationProperties.ElementRole="User">
                        <Border Classes="micDot" Classes.muted="{Binding IsMutedState}" Width="26" Height="26" CornerRadius="13">
                            <TextBlock Classes="glyph" FontSize="13" Foreground="White" HorizontalAlignment="Center" Text="{Binding StatusGlyph}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding StateLabel}" />
                        <Button Classes="accent" MinWidth="96" HorizontalContentAlignment="Center" Padding="14,6"
                                Content="{Binding ToggleMuteText}" Command="{Binding ToggleMuteCommand}" IsEnabled="{Binding IsMicrophoneConnected}" />
                    </StackPanel>
                    <!-- The system's caption buttons (3 x 46 px) sit over this column while the title bar is ours -->
                    <Border Grid.Column="4" Width="138" IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}" />
                </Grid>
            </Border>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="32,12,32,0" MaxWidth="1000">
                    <Border Classes="card caution" IsVisible="{Binding Capabilities.LimitationNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <DockPanel>
                            <TextBlock Classes="glyph" Text="&#xE7BA;" Margin="0,0,12,0" Foreground="{DynamicResource CautionForegroundBrush}" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Capabilities.LimitationNotice}" />
                        </DockPanel>
                    </Border>
                    <Border Classes="card" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" Padding="8"
                                    Command="{Binding DismissStatusCommand}" AutomationProperties.Name="Dismiss" />
                            <TextBlock Classes="glyph" Text="&#xE946;" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Panel>
                        <pages:HomePage IsVisible="{Binding IsHomePage}" />
                        <pages:SoundsPage IsVisible="{Binding IsSoundsPage}" />
                        <pages:OverlayPage IsVisible="{Binding IsOverlayPage}" />
                        <pages:HotkeysPage IsVisible="{Binding IsHotkeysPage}" />
                        <pages:AboutPage IsVisible="{Binding IsAboutPage}" />
                    </Panel>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>

        <pages:SetupView IsVisible="{Binding IsSetupVisible}" />
        <!-- Setup covers the header, so it gets its own strip to drag the window by -->
        <Border Height="52" VerticalAlignment="Top" Background="Transparent" IsVisible="{Binding IsSetupVisible}"
                chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    </Panel>
</Window>
