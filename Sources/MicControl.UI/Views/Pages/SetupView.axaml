<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MicControl.Controls"
             xmlns:vm="using:MicControl.ViewModels"
             xmlns:s="using:MicControl.Settings"
             xmlns:p="using:MicControl.Platform"
             x:Class="MicControl.Views.Pages.SetupView"
             x:DataType="vm:MainViewModel">
    <Border Background="{DynamicResource PageBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card setupCard" MaxWidth="640" Margin="24,40" Padding="32,28" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Skip setup" Command="{Binding SkipSetupCommand}" IsVisible="{Binding !IsSetupDone}" />
                        <TextBlock Classes="secondary" FontSize="13" VerticalAlignment="Center" Text="{Binding SetupProgressText}" IsVisible="{Binding !IsSetupDone}" />
                    </DockPanel>

                    <!-- Step 1: microphone -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsSetupStep1}">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Welcome! Which microphone do you use?" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" FontSize="14" Text="Pick the microphone you talk into. 'All microphones' mutes every one at once." />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Microphones}" SelectedValue="{Binding SelectedMicrophoneId}"
                                  DisplayMemberBinding="{Binding Name, x:DataType=p:AudioDeviceInfo}" SelectedValueBinding="{Binding Id, x:DataType=p:AudioDeviceInfo}" />
                        <TextBlock Classes="secondary" FontSize="14" Text="Say something: the bar should move. If it doesn't, try another microphone or press Unmute." />
                        <ProgressBar Classes="meter" Value="{Binding InputLevel}" />
                        <Button HorizontalAlignment="Left" Content="{Binding ToggleMuteText}" Command="{Binding ToggleMuteCommand}" />
                    </StackPanel>

                    <!-- Step 2: mode and key -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsSetupStep2}">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="How do you want to talk?" />
                        <RadioButton GroupName="mode" IsChecked="{Binding MuteMode, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:MainViewModel.PushToTalkMode}}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:MainViewModel.PushToTalkMode}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Push-to-talk (recommended)" />
                                <TextBlock Classes="secondary" Text="You're muted until you hold your key. Nobody hears background noise." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="mode" IsChecked="{Binding MuteMode, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:MainViewModel.ToggleMode}}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:MainViewModel.ToggleMode}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Toggle" />
                                <TextBlock Classes="secondary" Text="Press your key once to mute, again to unmute." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="mode" IsChecked="{Binding MuteMode, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:MainViewModel.PushToMuteMode}}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:MainViewModel.PushToMuteMode}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Push-to-mute" />
                                <TextBlock Classes="secondary" Text="You're live until you hold your key, e.g. to cough." />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding MainHotkeyLabel}" />
                        <TextBlock Classes="secondary" FontSize="14" Text="Click the box, then press the key or mouse button you want. A side mouse button or a key you don't use in games works well." />
                        <ContentControl Content="{Binding MainHotkey}" ContentTemplate="{StaticResource HotkeyEditorTemplate}" />
                    </StackPanel>

                    <!-- Step 3: finishing touches -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsSetupStep3}">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Finishing touches" Margin="0,0,0,8" />
                        <c:SettingRow Glyph="&#xE7F4;" Header="Show the overlay" Description="A small badge that shows whether you're muted">
                            <ToggleSwitch IsChecked="{Binding OverlayEnabled}" />
                        </c:SettingRow>
                        <c:SettingRow Glyph="&#xE8B0;" Header="Overlay corner" IsEnabled="{Binding OverlayEnabled}">
                            <!-- The same four corner buttons as the Overlay page -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8" FontFamily="{StaticResource IconFont}" Content="&#xE742;" Command="{Binding PlaceOverlayCommand}" CommandParameter="{x:Static s:OverlayCorner.TopLeft}" ToolTip.Tip="Top left" AutomationProperties.Name="Top left" />
                                <Button Padding="8" FontFamily="{StaticResource IconFont}" Content="&#xE742;" Command="{Binding PlaceOverlayCommand}" CommandParameter="{x:Static s:OverlayCorner.TopRight}" ToolTip.Tip="Top right" AutomationProperties.Name="Top right" RenderTransform="scaleX(-1)" />
                                <Button Padding="8" FontFamily="{StaticResource IconFont}" Content="&#xE742;" Command="{Binding PlaceOverlayCommand}" CommandParameter="{x:Static s:OverlayCorner.BottomLeft}" ToolTip.Tip="Bottom left" AutomationProperties.Name="Bottom left" RenderTransform="scaleY(-1)" />
                                <Button Padding="8" FontFamily="{StaticResource IconFont}" Content="&#xE742;" Command="{Binding PlaceOverlayCommand}" CommandParameter="{x:Static s:OverlayCorner.BottomRight}" ToolTip.Tip="Bottom right" AutomationProperties.Name="Bottom right" RenderTransform="scale(-1,-1)" />
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Glyph="&#xE995;" Header="Play sounds" Description="A short sound when you mute or unmute">
                            <ToggleSwitch IsChecked="{Binding SoundsEnabled}" />
                        </c:SettingRow>
                        <c:SettingRow Glyph="&#xE7E8;" Header="Start with Windows" Description="Opens MicControl in the tray when you sign in">
                            <ToggleSwitch IsChecked="{Binding RunAtStartup}" />
                        </c:SettingRow>
                        <c:SettingRow Glyph="&#xE73F;" Header="Close to the tray" Description="{Binding CloseToTrayDescription}">
                            <ToggleSwitch IsChecked="{Binding IsTrayMode}" AutomationProperties.Name="Close to the tray" />
                        </c:SettingRow>
                        <StackPanel Spacing="4" IsVisible="{Binding OffersImports}">
                            <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="Bring over more from MicSwitch?" />
                            <TextBlock Classes="secondary" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="These were found in your MicSwitch settings. You can turn them on or off later under About → Advanced." />
                            <c:SettingRow Glyph="&#xE765;" Header="Your custom hotkeys" Description="Extra keys bound to actions, e.g. toggle or speaker volume"
                                          IsVisible="{Binding OffersImportedCustomHotkeys}">
                                <ToggleSwitch IsChecked="{Binding CustomHotkeysEnabled}" AutomationProperties.Name="Import custom hotkeys" />
                            </c:SettingRow>
                            <c:SettingRow Glyph="&#xE995;" Header="Your sounds" Description="The sounds, volume and playback device you picked"
                                          IsVisible="{Binding OffersImportedSounds}">
                                <ToggleSwitch IsChecked="{Binding CustomSoundsEnabled}" AutomationProperties.Name="Import sounds" />
                            </c:SettingRow>
                        </StackPanel>
                    </StackPanel>

                    <!-- Done -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsSetupDone}">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="You're all set" />
                        <TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding MainHotkeySummary, StringFormat='{}{0}. Change anything later from Home.'}" IsVisible="{Binding HasMainHotkey}" />
                        <TextBlock FontSize="14" TextWrapping="Wrap" Text="Tip: MicControl lives in the notification area, near the clock. Right-click its icon for quick controls or to exit; click it to open this window." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Back" Command="{Binding SetupBackCommand}" IsVisible="{Binding CanGoBack}" />
                        <Button Classes="accent" MinWidth="110" HorizontalContentAlignment="Center" Content="{Binding SetupNextText}" Command="{Binding SetupNextCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Border>
</UserControl>
