<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MicControl.Controls"
             xmlns:vm="using:MicControl.ViewModels"
             xmlns:s="using:MicControl.Settings"
             xmlns:p="using:MicControl.Platform"
             x:Class="MicControl.Views.Pages.HotkeysPage"
             x:DataType="vm:MainViewModel">
    <StackPanel Classes="page">
        <TextBlock Classes="pageTitle" Text="Hotkeys" />
        <TextBlock Classes="pageSubtitle" Text="Bind more keys, each to one action: mute, unmute, toggle, speaker volume, overlay and more. Your main key is set on Home." />

        <TextBlock Classes="secondary" Margin="4,8,0,12" FontSize="14" Text="No custom hotkeys yet." IsVisible="{Binding !HasCustomHotkeys}" />
        <ItemsControl ItemsSource="{Binding CustomHotkeys}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomHotkeyViewModel">
                    <Border Classes="card">
                        <!-- Like every other row: what it does on the left, its on/off switch on the right -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <ComboBox MinWidth="240" VerticalAlignment="Center"
                                      ItemsSource="{Binding Actions}" SelectedValue="{Binding Action}"
                                      DisplayMemberBinding="{Binding Name, x:DataType=vm:Choice}" SelectedValueBinding="{Binding Value, x:DataType=vm:Choice}"
                                      AutomationProperties.Name="Action" />
                            <ToggleSwitch Grid.Column="2" Margin="0,0,12,0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                          ToolTip.Tip="Turn this hotkey on or off" AutomationProperties.Name="Enabled" />
                            <Button Grid.Column="3" Padding="8" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Content="&#xE74D;"
                                    Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this hotkey" AutomationProperties.Name="Remove" />
                            <ContentControl Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Content="{Binding Editor}" ContentTemplate="{StaticResource HotkeyEditorTemplate}" IsEnabled="{Binding IsEnabled}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="accent" Margin="0,8,0,0" Padding="14,8" Command="{Binding AddCustomHotkeyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="glyph" FontSize="14" Text="&#xE710;" />
                <TextBlock Text="Add hotkey" />
            </StackPanel>
        </Button>
        <TextBlock Classes="secondary" Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="{Binding !CanAddCustomHotkey}"
                   Text="That's the most custom hotkeys MicControl keeps (100). Remove one to add another." />

        <StackPanel IsVisible="{Binding HasSpeakerActions}">
            <TextBlock Classes="section" Text="Speakers" />
            <c:SettingRow Glyph="&#xE7F5;" Header="Speaker device" Description="Which output the speaker actions control">
                <ComboBox MinWidth="280" ItemsSource="{Binding Speakers}" SelectedValue="{Binding SelectedSpeakerId}"
                          DisplayMemberBinding="{Binding Name, x:DataType=p:AudioDeviceInfo}" SelectedValueBinding="{Binding Id, x:DataType=p:AudioDeviceInfo}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE767;" Header="Speaker volume">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding SpeakerVolume}" VerticalAlignment="Center" AutomationProperties.Name="Speaker volume" />
                    <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SpeakerVolume, StringFormat={}{0:0}%}" />
                </StackPanel>
            </c:SettingRow>
        </StackPanel>
    </StackPanel>
</UserControl>
