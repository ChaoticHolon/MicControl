<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows executable: wires the Avalonia UI (MicControlNG.UI) to the Windows platform services (MicControlNG.Windows). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\microphoneEnabled.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <!--
    Release builds are one self-contained file that is both the setup (MicControlNG-Setup-<version>.exe) and, once it
    has copied itself into place, the installed app. Native libraries unpack to %TEMP%\.net on first start (missing
    files are restored automatically); everything else runs from the file. See installer\build.ps1.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The built-in sounds travel inside the executable; installing writes them next to it (WindowsInstaller). -->
    <EmbeddedResource Include="..\MicControlNG.UI\Assets\Notifications\*.wav" LogicalName="Sounds/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicControlNG.UI\MicControlNG.UI.csproj" />
    <ProjectReference Include="..\MicControlNG.Windows\MicControlNG.Windows.csproj" />
  </ItemGroup>
</Project>
